
# set background
# output * bg /home/moiz/.config/backgrounds/012.jpg fill

for_window [class="float_small"] move scratchpad, scratchpad show, resize set 960 540, move position center
for_window [class="float_big"] move scratchpad, scratchpad show, resize set 1280 720, move position center
for_window [class="float_large"] move scratchpad, scratchpad show, resize set 1600 900, move position center


# include custom sway config
include "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf"

