{
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "custom/pacman",
            //"backlight",
            "pulseaudio",
            "battery",
            "bluetooth",
            "network"
        ]
    },
    "group/buttons": {
        "orientation": "horizontal",
        "modules": [
            "idle_inhibitor",
            "custom/power"
        ]
    },
    "group/dock": {
        "orientation": "horizontal",
        "modules": [
            "custom/launcher",
            "hyprland/workspaces",
            "mpd",
            "mpd#2",
            "mpd#3",
            "mpd#4",
            "custom/mpd",
            "hyprland/submap"
        ]
    },
    "group/window-tab": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/window",
            "tray"
        ]
    },
    "group/left": {
        "orientation": "horizontal",
        "modules": [
            "group/dock",
            "group/window-tab"
        ]
    },
    "group/right": {
        "orientation": "horizontal",
        "modules": [
            "group/status",
            "group/buttons"
        ]
    },
    "group/center": {
        "orientation": "horizontal",
        "modules": [
            "clock"
        ]
    }
}
