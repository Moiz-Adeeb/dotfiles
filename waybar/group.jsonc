{
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "group/pacman-drawer",
            //"backlight",
            "group/volume-drawer",
            "group/battery-drawer",
            "group/bluetooth-drawer",
            "group/network-drawer"
        ]
    },
    "group/buttons": {
        "orientation": "horizontal",
        "modules": [
            "idle_inhibitor",
            "custom/power"
        ]
    },
    "group/dock": {
        "orientation": "horizontal",
        "modules": [
            "custom/launcher",
            "hyprland/workspaces",
            "mpd",
            "mpd#2",
            "mpd#3",
            "mpd#4",
            "custom/mpd",
            "group/dwl",
            "hyprland/submap"
        ]
    },
    "group/dwl": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/dwl",
            "custom/dwl-01",
            "custom/dwl-02",
            "custom/dwl-03",
            "custom/dwl-04",
            "custom/dwl-05",
            "custom/dwl-06",
            "custom/dwl-07",
            "custom/dwl-08",
            "custom/dwl-09"
        ]
    },
    "group/window-tab": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/window",
            "tray"
        ]
    },
    "group/left": {
        "orientation": "horizontal",
        "modules": [
            "group/dock",
            "group/window-tab"
        ]
    },
    "group/right": {
        "orientation": "horizontal",
        "modules": [
            "group/status",
            "group/buttons"
        ]
    },
    "group/center": {
        "orientation": "horizontal",
        "modules": [
            "clock"
        ]
    }
}
