{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        //"source": "~/.config/fastfetch/logos/arch.txt",
        "color": {
            "1": "#22ff99",
            "2": "#00dd77"
        },
        "padding": {
            "top": 1,
            "right": 1,
            "left": 1
        }
    },
    "display": {
        "separator": "- "
    },
    "modules": [
        //"break",
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": "  ",
            "keyColor": "#c4a7e7",
            "format": ""
        },
        {
            "type": "kernel",
            "key": " 󰒓 ",
            "keyColor": "#c4a7e7",
            "format": "{} {}"
        },
        {
            "type": "host",
            "key": " 🖥 ",
            "keyColor": "#c4a7e7",
            "format": "{}{}"
        },
        {
            "type": "shell",
            "key": " >_",
            "keyColor": "#c4a7e7",
            "format": "{}"
        },
        {
            "type": "terminal",
            "key": "  ",
            "keyColor": "#c4a7e7",
            "format": "{}"
        },
        {
            "type": "wm",
            "key": "  ",
            "keyColor": "#c4a7e7",
            "format": "{}"
        },
        {
            "type": "cpu",
            "key": " 󰍛 ",
            "keyColor": "#c4a7e7",
            // "format": "{}"
        },
        {
            "type": "gpu",
            "key": " 󰢮 ",
            "keyColor": "#c4a7e7",
            "format": "Intel Haswell-ULT @ 1.10 GHZ"
        },
        {
            "type": "memory",
            "key": " 🎟 ",
            "keyColor": "#c4a7e7",
            "format": "{} {}"
        },
        {
            "type": "swap",
            "key": " 🎟 ",
            "keyColor": "#c4a7e7",
            "format": "{} {}"
        },
        {
            "type": "uptime",
            "key": "  ",
            "keyColor": "#c4a7e7",
            "format": "{} Days {} Hours {} Mins"
        },
        {
            "type": "battery",
            "key": "  ",
            "keyColor": "#c4a7e7",
            "format": ""
        },
        {
            "type": "packages",
            "key": "  ",
            "keyColor": "#c4a7e7",
        },
        {
            "type": "disk",
            "key": "  {}",
            "keyColor": "#c4a7e7",
            "format": "{} {}"
        }
        //"break",
        //"break",
        //"break"
    ]
}
