{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        //"source": "~/.config/fastfetch/logos/arch.txt",
        "color": {
            "1": "#22ff99",
            "2": "#00dd77"
        },
        "padding": {
            "top": 1,
            "right": 1,
            "left": 1
        }
    },
    "display": {
        "separator": " ── "
    },
    "modules": [
        //"break",
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": "     OS  ",
            "keyColor": "#c4a7e7",
            "format": "{2} ({8})"
        },
        {
            "type": "kernel",
            "key": " KERNEL 󰒓 ",
            "keyColor": "#c4a7e7",
            "format": "{} {} {4}"
        },
        {
            "type": "host",
            "key": "   HOST 🖥 ",
            "keyColor": "#c4a7e7",
            "format": "{2} {5}"
        },
        {
            "type": "shell",
            "key": "  SHELL >_",
            "keyColor": "#c4a7e7",
            "format": "{} {4}  {7}"
        },
        {
            "type": "terminal",
            "key": "   TERM  ",
            "keyColor": "#c4a7e7",
            "format": "{} {6} {2}"
        },
        {
            "type": "wm",
            "key": "     WM  ",
            "keyColor": "#c4a7e7",
            "format": "{} ({3})"
        },
        {
            "type": "cpu",
            "key": "    CPU 󰍛 ",
            "keyColor": "#c4a7e7",
            // "format": "{}"
        },
        {
            "type": "gpu",
            "key": "    GPU 󰢮 ",
            "keyColor": "#c4a7e7",
            "format": "{} {6} {3}"
            // "format": "Intel Haswell-ULT @ 1.10 GHZ"
        },
        {
            "type": "memory",
            "key": " MEMORY 🎟 ",
            "keyColor": "#c4a7e7",
            "format": "{}/{} {}"
        },
        {
            "type": "swap",
            "key": "   SWAP 🎟 ",
            "keyColor": "#c4a7e7",
            "format": "{}/{} {}"
        },
        {
            "type": "uptime",
            "key": " UPTIME  ",
            "keyColor": "#c4a7e7",
            "format": "{} Days {} Hours {} Mins"
        },
        {
            "type": "battery",
            "key": "BATTERY  ",
            "keyColor": "#c4a7e7",
            "format": ""
        },
        {
            "type": "packages",
            "key": "PACKAGE  ",
            "keyColor": "#c4a7e7",
        },
        {
            "type": "disk",
            "key": " DISK {5}  ",
            "keyColor": "#c4a7e7",
            "format": "Used({3}) Total({2})"
        }
        //"break",
        //"break",
        //"break"
    ]
}
