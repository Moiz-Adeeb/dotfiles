{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        //"source": "~/.config/fastfetch/logos/moiz.txt",
        "color": {
            "1": "#22ff99",
            "2": "#00dd77"
        },
        "padding": {
            "top": 1,
            "right": 1,
            "left": 1
        }
    },
    "display": {
        "separator": "- "
    },
    "modules": [
        //"break",
        "break",
        {
            "type": "title",
            "keyWidth": 10,
            "color": "#C4A7E7"
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "#c4a7e7",
            "color": "#e0def4",
            //"format": "Arch Linux"
        },
        {
            "type": "kernel",
            "key": "󰒓 ",
            "keyColor": "#c4a7e7",
            "color": "#e0def4",
            //"format": "Arch Linux"
        },
        {
            "type": "host",
            "key": "🖥 ",
            "keyColor": "#c4a7e7",
            "color": "#e0def4",
            //"format": "Moiz-PC"
        },
        {
            "type": "shell",
            "key": ">_",
            "keyColor": "#c4a7e7",
            "color": "#e0def4",
            //"format": "Fish"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "#c4a7e7",
            "color": "#e0def4"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "#c4a7e7",
            "color": "#e0def4",
            //"format": "{} (wayland)"
        },
        {
            "type": "cpu",
            "key": "󰍛 ",
            "keyColor": "#c4a7e7",
            "color": "#e0def4",
            //"format": "AMD Ryzen 3 3200G"
        },
        {
            "type": "gpu",
            "key": "󰢮 ",
            "keyColor": "#c4a7e7",
            "color": "#e0def4",
            "format": "Intel Haswell-ULT @ 1.10 GHZ"
        },
        {
            "type": "memory",
            "key": "🎟 ",
            "keyColor": "#c4a7e7",
            "color": "#e0def4",
            "format": "{} {}"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "#c4a7e7",
            "color": "#e0def4"
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "#c4a7e7",
            "color": "#e0def4"
        },
        //"break",
        //"break",
        //"break"
    ]
}
